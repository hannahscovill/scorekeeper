meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{protocol}}://{{baseUrl}}/profile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Origin: http://localhost:3000
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "displayName": "New <3"
  }
}

docs {
  Updates the profile for the currently authenticated user in Auth0 user_metadata.
  
  Changes will be reflected in new ID tokens issued after the update.
  
  ## Authentication
  Requires a valid Bearer token (inherited from collection).
  
  ## Prerequisites
  The server must be configured with Auth0 M2M credentials:
  - `AUTH0_M2M_CLIENT_ID`
  - `AUTH0_M2M_CLIENT_SECRET`
  
  ## Request Body
  - `displayName` (string, required): The user's display name
  
  ## Responses
  - `200`: Profile updated successfully
    ```json
    {
      "userId": "auth0|123456",
      "displayName": "New Display Name"
    }
    ```
  - `400`: Request body missing required field (displayName)
  - `401`: Authentication required or invalid token
  - `404`: User not found in Auth0
}
