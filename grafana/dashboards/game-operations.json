{
  "title": "Scorekeeper - Game Operations",
  "description": "Trace-based view of game operations: guesses, game loads, puzzle lookups",
  "tags": ["scorekeeper", "game"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "current": { "text": "prod", "value": "prod" },
        "options": [
          { "text": "prod", "value": "prod", "selected": true },
          { "text": "dev", "value": "dev", "selected": false }
        ],
        "query": "prod,dev"
      }
    ]
  },
  "panels": [
    {
      "title": "Guess Submissions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource_uid}" },
      "targets": [
        {
          "queryType": "traceqlmetrics",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name = \"submit_guess\" } | rate()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      }
    },
    {
      "title": "Guess Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource_uid}" },
      "targets": [
        {
          "queryType": "traceqlmetrics",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name = \"submit_guess\" } | quantile_over_time(duration, 0.5)",
          "refId": "p50"
        },
        {
          "queryType": "traceqlmetrics",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name = \"submit_guess\" } | quantile_over_time(duration, 0.95)",
          "refId": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "title": "Game State Loads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource_uid}" },
      "targets": [
        {
          "queryType": "traceqlmetrics",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name = \"get_game\" } | rate()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "title": "Puzzle Lookups",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource_uid}" },
      "targets": [
        {
          "queryType": "traceqlmetrics",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name = \"get_puzzles\" } | rate()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      }
    },
    {
      "title": "Database Operation Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource_uid}" },
      "targets": [
        {
          "queryType": "traceqlmetrics",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name =~ \"db\\..*\" } | quantile_over_time(duration, 0.95) by (name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "title": "Recent Guess Traces",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource_uid}" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"scorekeeper\" && resource.deployment.environment = \"$environment\" && name = \"submit_guess\" }",
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
